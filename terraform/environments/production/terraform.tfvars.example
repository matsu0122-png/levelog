# Non-secret values only. db_admin_password, db_app_password, and
# monitor_slack_webhook have no value here on purpose — supply via
# TF_VAR_* (or an equivalent secret-injection mechanism) at apply time,
# never committed.
#
# lb_vrid needs an actual value (any integer unique within the LB's
# broadcast domain works, e.g. 1) — left unset here only because it's this
# environment's one remaining required variable with no sensible built-in
# default; set via -var or TF_VAR_lb_vrid. lb_known_ip_addresses is left at
# its default ([]) for the first apply — see variables.tf and main.tf's
# network module call for the two-step bootstrap this requires.
#
# ssh_public_key / admin_ssh_cidrs: same as staging — real values are not
# committed, set via -var or TF_VAR_*.
#
# This file is a template: copy it to terraform.tfvars (gitignored — see
# ../../.gitignore) to actually use it, or pass these same values via -var/
# TF_VAR_* directly. Phase 16 made this explicit after finding that a plain
# terraform.tfvars alongside this file would NOT have been gitignored (only
# *.auto.tfvars was) — see docs/security-review.md.

sakura_zone       = "tk1a"
name_prefix       = "levelog-production"
db_admin_username = "levelog_migrate"
db_app_username   = "levelog_app"
monitor_target    = "levelog.matsu0122.com"
