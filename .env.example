# PostgreSQL
POSTGRES_USER=levelog
POSTGRES_PASSWORD=levelog
POSTGRES_DB=levelog
POSTGRES_PORT=5432

# Backend API
API_PORT=8080
# Local dev only. In staging/production this must point at the app-only
# restricted user (see terraform/modules/database) and use sslmode=require
# (or verify-full once the appliance's CA cert is confirmed obtainable) —
# see docs/database-design.md.
DATABASE_URL=postgres://levelog:levelog@db:5432/levelog?sslmode=disable
# Comma-separated list to allow multiple origins (e.g. staging + production).
FRONTEND_ORIGIN=http://localhost:5173
# Set to "true" once the app is served over HTTPS in production.
COOKIE_SECURE=false
# Leave empty for local development (defaults to the request host).
COOKIE_DOMAIN=
# One of: debug, info, warn, error.
LOG_LEVEL=info

# --- Backend tuning (all optional; defaults shown are used when unset) ---
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=20s
# HTTP_IDLE_TIMEOUT=60s
# Per-request deadline; also bounds how long a request may wait on the DB.
# REQUEST_TIMEOUT=10s
# How long to wait for in-flight requests to finish on SIGTERM/SIGINT.
# SHUTDOWN_TIMEOUT=15s
# How long to wait for the database to become reachable at startup.
# DB_CONNECT_TIMEOUT=10s
# DB_MAX_OPEN_CONNS=20
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m

# Frontend
FRONTEND_PORT=5173
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8080
