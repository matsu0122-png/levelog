# PostgreSQL
POSTGRES_USER=levelog
POSTGRES_PASSWORD=levelog
POSTGRES_DB=levelog
POSTGRES_PORT=5432

# Backend API
API_PORT=8080
DATABASE_URL=postgres://levelog:levelog@db:5432/levelog?sslmode=disable
FRONTEND_ORIGIN=http://localhost:5173
# Set to "true" once the app is served over HTTPS in production.
COOKIE_SECURE=false
# Leave empty for local development (defaults to the request host).
COOKIE_DOMAIN=

# Frontend
FRONTEND_PORT=5173
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8080
